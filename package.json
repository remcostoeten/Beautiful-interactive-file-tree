{
    "name": "beautiful-filetree-v2",
    "author": "Remco Stoeten",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "bun --bun next dev --turbopack",
        "build": "bun --bun next build --turbopack",
        "build:node": "next build --turbopack",
        "start": "bun --bun next start",
        "start:node": "next start",
        "lint": "bun --bun eslint .",
        "lint:fix": "bun --bun eslint . --fix",
        "format": "bun --bun prettier --write \"**/*.{js,jsx,ts,tsx,json,css,md}\"",
        "format:check": "bun --bun prettier --check \"**/*.{js,jsx,ts,tsx,json,css,md}\"",
        "check": "bun run lint && bun run format:check",
        "fix": "bun run lint:fix && bun run format",
        "analyze": "bun --bun next build --turbopack --profile",
        "type-check": "bun --bun tsc --noEmit"
    },
    "dependencies": {
        "@radix-ui/react-accordion": "^1.2.12",
        "@radix-ui/react-collapsible": "^1.1.12",
        "@radix-ui/react-dialog": "^1.1.15",
        "@radix-ui/react-radio-group": "^1.3.8",
        "@radix-ui/react-scroll-area": "^1.2.10",
        "@radix-ui/react-select": "^2.2.6",
        "@radix-ui/react-slot": "^1.2.3",
        "@radix-ui/react-switch": "^1.2.6",
        "@vercel/analytics": "^1.5.0",
        "@vercel/speed-insights": "^1.2.0",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "lucide-react": "^0.542.0",
        "marked": "^16.3.0",
        "next": "15.5.2",
        "next-themes": "^0.4.6",
        "react": "19.1.0",
        "react-dom": "19.1.0",
        "react-resizable-panels": "^3.0.5",
        "shiki": "^3.12.1",
        "sonner": "^2.0.7",
        "tailwind-merge": "^3.3.1"
    },
    "devDependencies": {
        "@next/eslint-plugin-next": "^15.5.2",
        "@tailwindcss/postcss": "^4",
        "@types/node": "^20",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "@typescript-eslint/eslint-plugin": "^8.42.0",
        "@typescript-eslint/parser": "^8.42.0",
        "eslint": "^9",
        "eslint-config-next": "15.5.2",
        "eslint-config-prettier": "^9.1.0",
        "eslint-plugin-prettier": "^5.2.1",
        "eslint-plugin-react": "^7.35.0",
        "eslint-plugin-react-hooks": "^4.6.2",
        "globals": "^15.8.0",
        "prettier": "^3.6.2",
        "tailwindcss": "^4",
        "tw-animate-css": "^1.3.7",
        "typescript": "^5"
    }
}
